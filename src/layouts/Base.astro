---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import { clinic } from '../config';
import { languages, langs, localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Language-neutral path of this page, e.g. '/about/'. */
  path: string;
  /** Languages this page exists in. Defaults to all. */
  available?: Lang[];
  /** Where the language switcher goes when this page has no translation. */
  fallbackPath?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  isHome?: boolean;
  noindex?: boolean;
  /** Scripts whose fonts the page needs. Defaults to the page language. */
  fontLangs?: Lang[];
}

const {
  lang,
  title,
  description,
  path,
  available = langs,
  fallbackPath = '/',
  type = 'website',
  jsonLd = [],
  isHome = false,
  noindex = false,
  fontLangs = [lang],
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(localePath(lang, path), site).href;
const fullTitle = isHome ? `${clinic.name} | ${title}` : `${title} | ${clinic.name}`;
const ogImage = new URL('/og-default.png', site).href;

const fonts: Record<Lang, string> = {
  en: '',
  kn: '&family=Noto+Sans+Kannada:wght@400;500;600&family=Noto+Serif+Kannada:wght@500;600',
  hi: '&family=Noto+Sans+Devanagari:wght@400;500;600&family=Noto+Serif+Devanagari:wght@500;600',
};
const fontsHref = `https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600&family=Noto+Serif:wght@500;600${fontLangs.map((l) => fonts[l]).join('')}&display=swap`;
---

<!doctype html>
<html lang={languages[lang].htmlLang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    {available.map((l) => (
      <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(localePath(l, path), site).href} />
    ))}
    {available.includes('en') && (
      <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />
    )}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf8f3" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang).skip}</a>
    <Header lang={lang} path={path} available={available} fallbackPath={fallbackPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileContactBar lang={lang} />
  </body>
</html>
