---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import { clinic } from '../config';
import { languages, langs, localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Language-neutral path of this page, e.g. '/about/'. */
  path: string;
  /** Languages this page exists in. Defaults to all. */
  available?: Lang[];
  type?: 'website' | 'article';
  jsonLd?: object[];
  isHome?: boolean;
  noindex?: boolean;
  /** Scripts whose fonts the page needs. Defaults to the page language. */
  fontLangs?: Lang[];
  /** Above-the-fold background photo; preloaded so it isn't discovered late via CSS. */
  heroImage?: string;
  /** Share-card image (og:image). Defaults to /og-default.png. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  lang,
  title,
  description,
  path,
  available = langs,
  type = 'website',
  jsonLd = [],
  isHome = false,
  noindex = false,
  fontLangs = [lang],
  heroImage,
  ogImage: ogImagePath,
  ogImageAlt = clinic.name,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(localePath(lang, path), site).href;
// Inner pages use the short name so the keyword-led title fits Google's ~60-character display.
const fullTitle = isHome ? `${clinic.name} | ${title}` : `${title} | ${clinic.shortName}`;
const ogImage = new URL(ogImagePath ?? '/og-default.png', site).href;

// Extra font families per language (e.g. Noto Sans Kannada) if more languages are added.
const fonts: Record<Lang, string> = {
  en: '',
};
const fontsHref = `https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600${fontLangs.map((l) => fonts[l]).join('')}&display=swap`;
---

<!doctype html>
<html lang={languages[lang].htmlLang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    {available.map((l) => (
      <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(localePath(l, path), site).href} />
    ))}
    {available.includes('en') && (
      <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />
    )}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {!ogImagePath && <meta property="og:image:width" content="1200" />}
    {!ogImagePath && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content={clinic.address.city} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1f3b2d" />

    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load fonts without blocking first paint; text shows in the fallback font until they arrive. -->
    <link rel="preload" as="style" href={fontsHref} />
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang).skip}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileContactBar lang={lang} />
  </body>
</html>
