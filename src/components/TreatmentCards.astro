---
// Grid of treatment cards: photo, name, one-line summary, link. Used on the home page.
import type { Treatment } from '../data/treatments';
import { localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  items: Treatment[];
  linkLabel: string;
}

const { lang, items, linkLabel } = Astro.props;
---

<ul class="card-grid">
  {items.map((tr) => (
    <li>
      <a class="card treatment-card" href={localePath(lang, `/treatments/${tr.slug}/`)}>
        <img src={tr.image} alt="" loading="lazy" />
        <span class="card-body">
          <span class="card-title">{tr.copy[lang].title}</span>
          <span class="card-text">{tr.copy[lang].summary}</span>
          <span class="card-link">{linkLabel} →</span>
        </span>
      </a>
    </li>
  ))}
</ul>
