---
// Small line icons (24px grid, drawn with currentColor) for highlights and contact details.
interface Props {
  name: 'doctor' | 'leaf' | 'bottle' | 'child' | 'clock' | 'pin' | 'phone' | 'mail' | 'check';
}

const { name } = Astro.props;
const paths: Record<Props['name'], string> = {
  doctor: 'M8 3v5a4 4 0 0 0 8 0V3M12 12v3a4 4 0 0 0 8 0v-1M20 14a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM6 3h4M14 3h4',
  leaf: 'M5 19C5 9 11 4 20 4c0 9-5 15-15 15ZM5 19l8-8',
  bottle: 'M10 3h4v3l2 3v10a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2V9l2-3V3ZM8 13h8',
  child: 'M12 7a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM7 11l5-2 5 2M12 9v6M9 21l3-6 3 6',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3 2',
  pin: 'M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12ZM12 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z',
  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
  check: 'M5 12l5 5L20 7',
};
---

<svg class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]} />
</svg>
