---
import { clinic, fullAddress } from '../config';
import { localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">
        <img class="brand-emblem" src="/images/logo.jpg" alt="" width="40" height="40" loading="lazy" />
        <span class="footer-name">{clinic.name}</span>
      </p>
      <p class="footer-tagline">{clinic.tagline}…</p>
      <address>
        {fullAddress}<br />
        <a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a><br />
        <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
      </address>
    </div>
    <div>
      <p class="footer-label">{s.contact.hours}</p>
      <p>{s.hours.text}<br />{s.hours.closed}</p>
    </div>
    <nav aria-label={s.footerNavLabel}>
      <ul>
        <li><a href={localePath(lang, '/treatments/')}>{s.nav.treatments}</a></li>
        <li><a href={localePath(lang, '/about/')}>{s.nav.about}</a></li>
        <li><a href={localePath(lang, '/blog/')}>{s.nav.blog}</a></li>
        <li><a href={localePath(lang, '/contact/')}>{s.nav.contact}</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p class="disclaimer">{s.footer.disclaimer}</p>
    <p>© {year} {clinic.name}. {s.footer.rights}</p>
  </div>
</footer>
