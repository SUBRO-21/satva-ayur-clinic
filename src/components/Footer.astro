---
import { clinic, fullAddress } from '../config';
import { facilities } from '../data/facilities';
import { localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">
        <img class="brand-emblem" src="/images/logo.jpg" alt="" width="44" height="44" loading="lazy" />
        <span class="footer-name">{clinic.name}</span>
      </p>
      <p class="footer-tagline">{clinic.tagline}…</p>
      <address>{fullAddress}</address>
      <p>
        <a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a> · <a href={`tel:${clinic.mobileHref}`}>{clinic.mobile}</a><br />
        <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
      </p>
    </div>
    <div>
      <p class="footer-label">{s.contact.hours}</p>
      <p>
        <strong>{s.hours.consultationLabel}</strong><br />
        {s.hours.consultationDays}<br />{s.hours.consultation}
      </p>
      <p>
        <strong>{s.hours.therapiesLabel}</strong><br />
        {s.hours.therapiesDays}<br />{s.hours.therapies}
      </p>
    </div>
    <nav aria-label={s.nav.facilities}>
      <p class="footer-label">{s.nav.facilities}</p>
      <ul>
        {facilities.map((f) => (
          <li><a href={localePath(lang, `/facilities/${f.slug}/`)}>{f.title}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label={s.footerNavLabel}>
      <p class="footer-label">{clinic.shortName}</p>
      <ul>
        <li><a href={localePath(lang, '/about/')}>{s.nav.about}</a></li>
        <li><a href={localePath(lang, '/blog/')}>{s.nav.blog}</a></li>
        <li><a href={localePath(lang, '/contact/')}>{s.nav.contact}</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p class="disclaimer">{s.footer.disclaimer}</p>
    <p>© {year} {clinic.name}. {s.footer.rights}</p>
  </div>
</footer>
