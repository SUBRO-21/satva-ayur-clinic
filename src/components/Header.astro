---
import { clinic } from '../config';
import { facilities } from '../data/facilities';
import { localePath, t, whatsappLink, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const s = t(lang);

const links = [
  { href: '/', label: s.nav.home },
  { href: '/facilities/', label: s.nav.facilities, mega: true },
  { href: '/about/', label: s.nav.about },
  { href: '/blog/', label: s.nav.blog },
  { href: '/contact/', label: s.nav.contact },
];

const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath(lang, '/')}>
      <img class="brand-emblem" src="/images/logo.jpg" alt="" width="48" height="48" />
      <span class="brand-text">
        <span class="brand-name">{clinic.shortName}</span>
        <span class="brand-sub">{s.brandSub}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label={s.navLabel}>
      <ul>
        {links.map((l) => (
          <li class={l.mega ? 'has-mega' : undefined}>
            <a href={localePath(lang, l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}{l.mega && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {l.mega && (
              /* Opens on hover or keyboard focus; the link above still goes to the Facilities page. */
              <div class="mega">
                <div class="mega-inner">
                  <div class="mega-intro">
                    <p class="eyebrow">{s.nav.facilities}</p>
                    <p class="mega-title">{s.facilities.menuText}</p>
                    <a class="text-link" href={localePath(lang, '/facilities/')}>{s.facilities.viewAll} →</a>
                  </div>
                  <ul class="mega-grid">
                    {facilities.map((f) => (
                      <li>
                        <a class="mega-card bg-photo" href={localePath(lang, `/facilities/${f.slug}/`)} style={`--bg-image: url(${f.image})`}>
                          <span class="mega-card-title">{f.title}</span>
                          <span class="mega-card-text">{f.tagline}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn-soft btn-sm" href={whatsappLink(clinic.whatsapp, s.cta.whatsappMessage)} target="_blank" rel="noopener">{s.cta.whatsapp}</a>
      <a class="btn btn-primary btn-sm" href={`tel:${clinic.phoneHref}`}>{s.cta.bookShort}</a>
    </div>

    <details class="nav-mobile">
      <summary>{s.menu}</summary>
      <nav aria-label={s.navLabel}>
        <ul>
          {links.map((l) => (
            <li>
              <a href={localePath(lang, l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
              {l.mega && (
                <ul class="nav-sub">
                  {facilities.map((f) => (
                    <li><a href={localePath(lang, `/facilities/${f.slug}/`)}>{f.title}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
