---
import Base from '../../../layouts/Base.astro';
import ContactBlock from '../../../components/ContactBlock.astro';
import PostCard from '../../../components/PostCard.astro';
import { langStaticPaths, localePath, t, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../lib/blog';

export const getStaticPaths = langStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const [latest, ...rest] = await getPosts(lang);
---

<Base lang={lang} title={s.blog.metaTitle} description={s.blog.metaDescription} path="/blog/">
  <section class="page-head page-head-dark bg-photo" style="--bg-image: url(/images/shirodhara-garden.jpg)">
    <div class="container narrow">
      <p class="eyebrow">{s.blog.eyebrow}</p>
      <h1>{s.blog.title}</h1>
      <p class="lead">{s.blog.intro}</p>
    </div>
  </section>

  <section class="section tone-sand">
    <div class="container">
      {latest ? (
        <>
          <PostCard lang={lang} post={latest} featured />
          {rest.length > 0 && (
            <ul class="card-grid blog-grid">
              {rest.map((post) => <li><PostCard lang={lang} post={post} /></li>)}
            </ul>
          )}
        </>
      ) : (
        <p>
          {s.blog.empty} <a class="text-link" href={localePath(lang, '/')}>{s.blog.emptyLink}</a>
        </p>
      )}
    </div>
  </section>

  <ContactBlock lang={lang} />
</Base>
