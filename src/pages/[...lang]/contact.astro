---
import Base from '../../layouts/Base.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import { clinic, fullAddress } from '../../config';
import { langStaticPaths, t, whatsappLink, type Lang } from '../../i18n/ui';
import { clinicSchema } from '../../lib/schema';

export const getStaticPaths = langStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
---

<Base lang={lang} title={s.contact.metaTitle} description={s.contact.metaDescription} path="/contact/" jsonLd={[clinicSchema(Astro.site!)]}>
  <section class="page-head page-head-dark bg-photo" style="--bg-image: url(/images/hero-room.jpg)">
    <div class="container narrow">
      <h1>{s.contact.title}</h1>
      <p class="lead">{s.contact.intro}</p>
      <div class="btn-row">
        <ContactButtons lang={lang} />
      </div>
    </div>
  </section>

  <section class="section tone-sand">
    <div class="container split">
      <dl class="contact-list">
        <div><dt>{s.contact.address}</dt><dd><address>{fullAddress}</address><a class="text-link" href={clinic.mapsLink} target="_blank" rel="noopener">{s.contact.directions} →</a></dd></div>
        <div><dt>{s.contact.phone}</dt><dd><a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a><br /><a href={`tel:${clinic.mobileHref}`}>{clinic.mobile}</a></dd></div>
        <div><dt>{s.cta.whatsapp}</dt><dd><a href={whatsappLink(clinic.whatsapp, s.cta.whatsappMessage)} target="_blank" rel="noopener">{clinic.whatsappDisplay}</a></dd></div>
        <div><dt>{s.contact.email}</dt><dd><a href={`mailto:${clinic.email}`}>{clinic.email}</a></dd></div>
        <div>
          <dt>{s.contact.hours}</dt>
          <dd>
            <strong>{s.hours.consultationLabel}</strong> — {s.hours.consultationDays}, {s.hours.consultation}<br />
            <strong>{s.hours.therapiesLabel}</strong> — {s.hours.therapiesDays}, {s.hours.therapies}
          </dd>
        </div>
      </dl>
      <iframe class="map map-tall" src={clinic.mapsEmbed} title={s.contact.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>
