---
import Base from '../../../layouts/Base.astro';
import ContactBlock from '../../../components/ContactBlock.astro';
import TreatmentList from '../../../components/TreatmentList.astro';
import { treatments, type Treatment } from '../../../data/treatments';
import { langParam, langs, localePath, t, type Lang } from '../../../i18n/ui';
import { breadcrumbSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return langs.flatMap((lang) =>
    treatments.map((treatment) => ({
      params: { lang: langParam(lang), slug: treatment.slug },
      props: { lang, treatment },
    })),
  );
}

const { lang, treatment } = Astro.props as { lang: Lang; treatment: Treatment };
const s = t(lang);
const c = treatment.copy[lang];
const path = `/treatments/${treatment.slug}/`;
const abs = (p: string) => new URL(localePath(lang, p), Astro.site).href;
const others = treatments.filter((tr) => tr.slug !== treatment.slug);
---

<Base
  lang={lang}
  title={s.treatments.pageTitle.replace('{title}', c.title)}
  description={c.summary}
  path={path}
  jsonLd={[
    breadcrumbSchema([
      { name: s.nav.treatments, url: abs('/treatments/') },
      { name: c.title, url: abs(path) },
    ]),
  ]}
>
  <section class="page-head">
    <div class="container narrow">
      <p class="breadcrumb"><a href={localePath(lang, '/treatments/')}>{s.treatments.all}</a></p>
      <h1>{c.title}</h1>
      <p class="lead">{c.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow prose">
      {c.body.map((p) => <p>{p}</p>)}
      <h2>{s.treatments.conditions}</h2>
      <ul>
        {c.conditions.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <ContactBlock lang={lang} title={s.treatments.ask} />

  <section class="section">
    <div class="container two-col">
      <div class="col-head">
        <h2>{s.treatments.all}</h2>
      </div>
      <TreatmentList lang={lang} items={others} />
    </div>
  </section>
</Base>
