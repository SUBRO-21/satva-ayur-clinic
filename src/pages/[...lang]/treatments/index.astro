---
import Base from '../../../layouts/Base.astro';
import ContactBlock from '../../../components/ContactBlock.astro';
import { treatments } from '../../../data/treatments';
import { langStaticPaths, localePath, t, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
---

<Base lang={lang} title={s.treatments.metaTitle} description={s.treatments.metaDescription} path="/treatments/">
  <section class="page-head">
    <div class="container narrow">
      <h1>{s.treatments.title}</h1>
      <p class="lead">{s.treatments.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="treatment-list">
        {treatments.map((tr) => {
          const c = tr.copy[lang];
          return (
            <li>
              <h2><a href={localePath(lang, `/treatments/${tr.slug}/`)}>{c.title}</a></h2>
              <p>{c.summary}</p>
              <p class="muted">{s.treatments.conditions}: {c.conditions.join(', ')}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <ContactBlock lang={lang} />
</Base>
