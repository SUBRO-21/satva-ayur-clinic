---
// Consultation request form. Sends to the clinic's email through Web3Forms (when a key is set
// in config.ts) and always offers WhatsApp as an alternative. In-clinic consultations only.
import Base from '../../layouts/Base.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import { clinic, fullAddress } from '../../config';
import { langStaticPaths, t, type Lang } from '../../i18n/ui';
import { clinicSchema } from '../../lib/schema';

export const getStaticPaths = langStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const c = s.consultation;
const hasEmail = Boolean(clinic.web3formsKey);
---

<Base lang={lang} title={c.metaTitle} description={c.metaDescription} path="/consultation/" heroImage="/images/hero-shirodhara.jpg" jsonLd={[clinicSchema(Astro.site!)]}>
  <section class="page-head page-head-dark bg-photo" style="--bg-image: url(/images/hero-shirodhara.jpg)">
    <div class="container narrow">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.intro}</p>
      <p class="chip-row">
        <span class="chip">{s.hours.consultationDays}</span>
        <span class="chip">{s.hours.consultation}</span>
      </p>
    </div>
  </section>

  <section class="section tone-sand">
    <div class="container consult-layout">
      <div class="panel consult-card">
        <form
          id="consult-form"
          class="consult-form"
          novalidate
          data-key={clinic.web3formsKey}
          data-wa={clinic.whatsapp}
          data-wa-intro={c.waIntro}
          data-sending={c.sending}
          data-submit={c.submit}
          data-err-name={c.errors.name}
          data-err-phone={c.errors.phone}
          data-err-email={c.errors.email}
          data-err-date={c.errors.date}
          data-err-sunday={c.errors.sunday}
          data-err-consent={c.errors.consent}
        >
          <h2 class="consult-title">{c.formTitle}</h2>
          <p class="muted consult-note">{c.formNote}</p>

          <fieldset class="form-group">
            <legend><span class="step-num">1</span>{c.groupYou}</legend>
            <div class="field-grid">
              <div class="field field-wide">
                <label for="f-name">{c.name} <span class="req">*</span></label>
                <input id="f-name" name="name" type="text" autocomplete="name" required />
                <p class="field-error" id="e-name" hidden></p>
              </div>
              <div class="field">
                <label for="f-phone">{c.phone} <span class="req">*</span></label>
                <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="98765 43210" required aria-describedby="h-phone" />
                <p class="field-hint" id="h-phone">{c.phoneHint}</p>
                <p class="field-error" id="e-phone" hidden></p>
              </div>
              <div class="field">
                <label for="f-email">{c.email}</label>
                <input id="f-email" name="email" type="email" autocomplete="email" />
                <p class="field-error" id="e-email" hidden></p>
              </div>
              <div class="field">
                <label for="f-age">{c.age}</label>
                <input id="f-age" name="age" type="number" inputmode="numeric" min="0" max="120" />
              </div>
              <div class="field">
                <span class="label" id="l-gender">{c.gender}</span>
                <div class="pill-options" role="radiogroup" aria-labelledby="l-gender">
                  {c.genders.map((g) => (
                    <label class="pill-option"><input type="radio" name="gender" value={g} /><span>{g}</span></label>
                  ))}
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="form-group">
            <legend><span class="step-num">2</span>{c.groupVisit}</legend>
            <div class="field-grid">
              <div class="field field-wide">
                <span class="label" id="l-for">{c.forWhom}</span>
                <div class="pill-options" role="radiogroup" aria-labelledby="l-for">
                  {c.forWhomOptions.map((o, i) => (
                    <label class="pill-option"><input type="radio" name="for" value={o} checked={i === 0} /><span>{o}</span></label>
                  ))}
                </div>
              </div>
              <div class="field field-wide">
                <label for="f-concern">{c.concern}</label>
                <select id="f-concern" name="concern">
                  <option value="">{c.concernPlaceholder}</option>
                  {c.concerns.map((o) => <option value={o}>{o}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="f-date">{c.date} <span class="req">*</span></label>
                <input id="f-date" name="date" type="date" required aria-describedby="h-date" />
                <p class="field-hint" id="h-date">{c.dateHint}</p>
                <p class="field-error" id="e-date" hidden></p>
              </div>
              <div class="field">
                <label for="f-time">{c.time}</label>
                <select id="f-time" name="time">
                  {c.times.map((o) => <option value={o}>{o}</option>)}
                </select>
              </div>
              <div class="field field-wide">
                <span class="label" id="l-visit">{c.visitType}</span>
                <div class="pill-options" role="radiogroup" aria-labelledby="l-visit">
                  {c.visitTypes.map((o, i) => (
                    <label class="pill-option"><input type="radio" name="visit" value={o} checked={i === 0} /><span>{o}</span></label>
                  ))}
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="form-group">
            <legend><span class="step-num">3</span>{c.groupMore}</legend>
            <div class="field">
              <label for="f-message">{c.message}</label>
              <textarea id="f-message" name="message" rows="4" placeholder={c.messagePlaceholder}></textarea>
            </div>
            <label class="consent">
              <input id="f-consent" name="consent" type="checkbox" required />
              <span>{c.consent} <span class="req">*</span></span>
            </label>
            <p class="field-error" id="e-consent" hidden></p>
          </fieldset>

          {/* Spam trap for bots; hidden from people. */}
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="form-actions">
            {hasEmail && <button type="submit" class="btn btn-primary" id="btn-submit">{c.submit}</button>}
            <button type="button" class={`btn ${hasEmail ? 'btn-secondary' : 'btn-primary'}`} id="btn-wa">{hasEmail ? c.whatsapp : c.whatsappOnly}</button>
          </div>
          <p class="form-status" id="form-status" role="alert" hidden>{c.failText}</p>
          <p class="muted consult-privacy">{c.privacy}</p>
        </form>

        <div class="consult-success" id="consult-success" hidden tabindex="-1">
          <span class="success-mark" aria-hidden="true">✓</span>
          <h2>{c.successTitle}</h2>
          <p>{c.successText}</p>
          <div class="btn-row"><ContactButtons lang={lang} /></div>
        </div>
      </div>

      <aside class="consult-aside">
        <div class="panel aside-card">
          <p class="pill-label">{c.asideTitle}</p>
          <div class="aside-doctor">
            <img src={clinic.doctor.photo} alt={clinic.doctor.name} width="96" height="120" loading="lazy" />
            <div>
              <p class="aside-name">{clinic.doctor.name}</p>
              <p class="muted">{clinic.doctor.qualification} · {clinic.doctor.experienceYears}+ {s.about.experience}</p>
              <p class="muted">{clinic.doctor.registration}</p>
            </div>
          </div>
          <p class="aside-text">{s.home.doctorText}</p>
        </div>

        <div class="panel aside-card">
          <p class="aside-label">{c.timingsTitle}</p>
          <p><strong>{s.hours.consultationDays}</strong><br />{s.hours.consultation}</p>
          <p class="aside-label">{c.whereTitle}</p>
          <address>{fullAddress}</address>
          <a class="text-link" href={clinic.mapsLink} target="_blank" rel="noopener">{s.contact.directions} →</a>
          <p class="aside-bring">{c.bring}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="center-title">{c.stepsTitle}</h2>
      <ol class="steps">
        {c.steps.map((st, i) => (
          <li>
            <span class="step-num step-num-lg">{i + 1}</span>
            <h3>{st.title}</h3>
            <p class="muted">{st.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactBlock lang={lang} />
</Base>

<script>
  const form = document.getElementById('consult-form') as HTMLFormElement | null;
  if (form) {
    const d = form.dataset;
    const el = (id: string) => document.getElementById(id) as HTMLElement;
    const dateInput = el('f-date') as HTMLInputElement;

    // Earliest date is today, in the visitor's own timezone.
    const now = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    dateInput.min = today;

    const setError = (field: string, msg: string | null) => {
      const err = el(`e-${field}`);
      const input = el(`f-${field}`);
      err.hidden = !msg;
      err.textContent = msg ?? '';
      input.toggleAttribute('aria-invalid', Boolean(msg));
    };

    const validate = (): boolean => {
      const fd = new FormData(form);
      const name = String(fd.get('name') ?? '').trim();
      const phone = String(fd.get('phone') ?? '').replace(/[\s()-]/g, '');
      const email = String(fd.get('email') ?? '').trim();
      const date = String(fd.get('date') ?? '');
      const errors: Record<string, string | null> = {
        name: name ? null : d.errName!,
        phone: /^(\+?91)?0?[6-9]\d{9}$/.test(phone) ? null : d.errPhone!,
        email: !email || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? null : d.errEmail!,
        date: !date || date < today ? d.errDate! : new Date(`${date}T00:00`).getDay() === 0 ? d.errSunday! : null,
        consent: (el('f-consent') as HTMLInputElement).checked ? null : d.errConsent!,
      };
      Object.entries(errors).forEach(([k, v]) => setError(k, v));
      const first = Object.keys(errors).find((k) => errors[k]);
      if (first) el(`f-${first}`).focus();
      return !first;
    };

    // Clear a field's error as soon as it is corrected.
    form.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const key = target.id?.replace('f-', '');
      if (key && document.getElementById(`e-${key}`) && !el(`e-${key}`).hidden) validate();
    });

    const summary = (): string => {
      const fd = new FormData(form);
      const line = (label: string, key: string) => {
        const v = String(fd.get(key) ?? '').trim();
        return v ? `${label}: ${v}` : null;
      };
      return [
        d.waIntro!,
        '',
        line('Name', 'name'),
        line('Phone', 'phone'),
        line('Email', 'email'),
        line('Age', 'age'),
        line('Gender', 'gender'),
        line('For', 'for'),
        line('Concern', 'concern'),
        line('Preferred date', 'date'),
        line('Preferred time', 'time'),
        line('Visit', 'visit'),
        line('Message', 'message'),
      ].filter((l) => l !== null).join('\n');
    };

    el('btn-wa').addEventListener('click', () => {
      if (!validate()) return;
      window.open(`https://wa.me/${d.wa}?text=${encodeURIComponent(summary())}`, '_blank', 'noopener');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!d.key || !validate()) return;
      const fd = new FormData(form);
      if (fd.get('botcheck')) return;
      const btn = el('btn-submit') as HTMLButtonElement;
      const status = el('form-status');
      btn.disabled = true;
      btn.textContent = d.sending!;
      status.hidden = true;
      try {
        const payload: Record<string, unknown> = Object.fromEntries(fd.entries());
        payload.access_key = d.key;
        payload.subject = `Consultation request — ${fd.get('name')} (${fd.get('date')})`;
        payload.from_name = 'Satva Ayur website';
        delete payload.botcheck;
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message || 'Failed');
        form.hidden = true;
        const ok = el('consult-success');
        ok.hidden = false;
        ok.focus();
      } catch {
        status.hidden = false;
      } finally {
        btn.disabled = false;
        btn.textContent = d.submit!;
      }
    });
  }
</script>
