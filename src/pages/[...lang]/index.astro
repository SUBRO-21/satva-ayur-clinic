---
import Base from '../../layouts/Base.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import FacilityCards from '../../components/FacilityCards.astro';
import Icon from '../../components/Icon.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import PostCard from '../../components/PostCard.astro';
import { clinic, fullAddress } from '../../config';
import { facilities } from '../../data/facilities';
import { langStaticPaths, localePath, t, type Lang } from '../../i18n/ui';
import { getPosts } from '../../lib/blog';
import { clinicSchema } from '../../lib/schema';

export const getStaticPaths = langStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const posts = (await getPosts(lang)).slice(0, 3);
const highlightIcons = ['doctor', 'leaf', 'bottle', 'child'] as const;
const signature = facilities.find((f) => f.slug === 'ayur-satva-signature')!;
// The signature programmes get their own band below, so leave them out of the main grid.
const mainFacilities = facilities.filter((f) => f.slug !== signature.slug);
---

<Base
  lang={lang}
  title={s.home.metaTitle}
  description={s.home.metaDescription}
  path="/"
  isHome
  jsonLd={[clinicSchema(Astro.site!)]}
>
  <section class="hero">
    <img class="hero-photo" src="/images/hero-room.jpg" alt="" fetchpriority="high" />
    <div class="container">
      <div class="hero-text">
        <p class="pill-label">{s.home.eyebrow}</p>
        <h1 class="hero-title">{s.home.title}</h1>
        <p class="hero-tagline">{s.home.tagline}</p>
        <dl class="hero-principles">
          {s.home.principles.map((p) => (
            <div><dt>{p.name}:</dt> <dd>{p.text}</dd></div>
          ))}
        </dl>
        <div class="btn-row">
          <ContactButtons lang={lang} />
        </div>
        <p class="hero-meta">
          <Icon name="phone" /> <a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a>
          <span aria-hidden="true">·</span>
          <a href={`tel:${clinic.mobileHref}`}>{clinic.mobile}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="highlights">
    <ul class="container highlight-row">
      {s.home.highlights.map((h, i) => (
        <li>
          <span class="icon-badge"><Icon name={highlightIcons[i]} /></span>
          <span><strong>{h.title}</strong><span>{h.text}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="container philosophy">
      <div>
        <p class="pill-label">{s.home.philosophyEyebrow}</p>
        <h2 class="display">{s.home.philosophyTitle}</h2>
        <p class="lead">{s.home.philosophyText}</p>
        <a class="text-link" href={localePath(lang, '/about/')}>{s.home.doctorLink} →</a>
      </div>
      <div class="principle-panel bg-photo on-dark" style="--bg-image: url(/images/shirodhara-garden.jpg)">
        {s.home.principles.map((p) => (
          <blockquote class="principle">
            <p class="principle-name">{p.name}</p>
            <p>{p.text}</p>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="section tone-sand">
    <div class="container">
      <div class="section-head-row">
        <div>
          <p class="pill-label">{s.home.facilitiesEyebrow}</p>
          <h2 class="display">{s.home.facilitiesTitle}</h2>
          <p class="muted">{s.home.facilitiesText}</p>
        </div>
        <a class="text-link" href={localePath(lang, '/facilities/')}>{s.facilities.viewAll} →</a>
      </div>
      <FacilityCards lang={lang} items={mainFacilities} showAll />
    </div>
  </section>

  <section class="section tone-forest bg-photo on-dark" style="--bg-image: url(/images/shirodhara-garden.jpg)">
    <div class="container">
      <div class="section-head-row">
        <div>
          <p class="pill-label">{s.home.signatureEyebrow}</p>
          <h2 class="display">{s.home.signatureTitle}</h2>
          <p>{s.home.signatureText}</p>
        </div>
        <a class="text-link" href={localePath(lang, `/facilities/${signature.slug}/`)}>{s.home.signatureLink} →</a>
      </div>
      <ul class="signature-grid">
        {signature.therapies.map((th) => (
          <li class="signature">
            <div class="therapy-head">
              <h3>{th.name}</h3>
              <span class="chip">{th.duration}</span>
            </div>
            <p class="chip-row">
              {th.includes?.map((item) => <span class="chip chip-soft">{item}</span>)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="panel doctor">
        <PhotoPlaceholder label="doctor portrait" variant="portrait" />
        <div>
          <p class="pill-label">{s.home.doctorTitle}</p>
          <h2 class="doctor-name">{clinic.doctor.name}</h2>
          <p class="muted">{clinic.doctor.qualification} · {clinic.doctor.registration}</p>
          <p>{s.home.doctorText}</p>
          <a class="text-link" href={localePath(lang, '/about/')}>{s.home.doctorLink} →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section tone-sand">
    <div class="container">
      <p class="pill-label">{s.home.visitEyebrow}</p>
      <h2 class="display">{s.home.visitTitle}</h2>
      <div class="visit-grid">
        <div class="hours-card">
          <Icon name="clock" />
          <p class="hours-label">{s.hours.consultationLabel}</p>
          <p class="hours-days">{s.hours.consultationDays}</p>
          <p class="hours-time">{s.hours.consultation}</p>
        </div>
        <div class="hours-card">
          <Icon name="leaf" />
          <p class="hours-label">{s.hours.therapiesLabel}</p>
          <p class="hours-days">{s.hours.therapiesDays}</p>
          <p class="hours-time">{s.hours.therapies}</p>
        </div>
        <div class="hours-card hours-card-wide">
          <Icon name="pin" />
          <p class="hours-label">{s.contact.address}</p>
          <address>{fullAddress}</address>
          <p>
            <a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a> · <a href={`tel:${clinic.mobileHref}`}>{clinic.mobile}</a><br />
            <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
          </p>
          <a class="text-link" href={clinic.mapsLink} target="_blank" rel="noopener">{s.contact.directions} →</a>
        </div>
      </div>
      <iframe class="map map-wide" src={clinic.mapsEmbed} title={s.contact.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section-tight">
      <div class="container">
        <div class="section-head-row">
          <h2 class="display">{s.home.blogTitle}</h2>
          <a class="text-link" href={localePath(lang, '/blog/')}>{s.home.blogLink} →</a>
        </div>
        <ul class="card-grid">
          {posts.map((post) => <li><PostCard lang={lang} post={post} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <ContactBlock lang={lang} />
</Base>
