---
import Base from '../../layouts/Base.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import TreatmentList from '../../components/TreatmentList.astro';
import { clinic, fullAddress } from '../../config';
import { treatments } from '../../data/treatments';
import { formatDate, langStaticPaths, localePath, t, type Lang } from '../../i18n/ui';
import { getPosts, postSlug } from '../../lib/blog';
import { clinicSchema } from '../../lib/schema';

export const getStaticPaths = langStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const posts = (await getPosts(lang)).slice(0, 3);
---

<Base
  lang={lang}
  title={s.home.metaTitle}
  description={s.home.metaDescription}
  path="/"
  isHome
  jsonLd={[clinicSchema(Astro.site!)]}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{s.home.eyebrow}</p>
      <h1 class="hero-title">{s.home.title}</h1>
      <div class="hero-body">
        <p class="lead">{s.home.text}</p>
        <div>
          <div class="btn-row">
            <ContactButtons lang={lang} />
          </div>
          <p class="hero-meta">{s.hours.text} · {s.hours.closed}</p>
        </div>
      </div>
    </div>
  </section>

  <PhotoPlaceholder label="clinic interior or a therapy in progress (wide, landscape)" />

  <section class="section">
    <div class="container two-col">
      <div class="col-head">
        <h2>{s.home.treatmentsTitle}</h2>
        <p class="muted">{s.home.treatmentsText}</p>
      </div>
      <TreatmentList lang={lang} items={treatments} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container two-col">
      <div class="col-head">
        <h2>{s.home.approachTitle}</h2>
      </div>
      <ol class="steps">
        {s.home.approach.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container doctor">
      <PhotoPlaceholder label="doctor portrait" variant="portrait" />
      <div>
        <p class="eyebrow">{s.home.doctorTitle}</p>
        <h2 class="doctor-name">{clinic.doctor.name}</h2>
        <p class="muted">{clinic.doctor.qualification}</p>
        <p>{s.home.doctorText}</p>
        <a class="text-link" href={localePath(lang, '/about/')}>{s.home.doctorLink} →</a>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section-rule">
      <div class="container">
        <div class="section-head-row">
          <h2>{s.home.blogTitle}</h2>
          <a class="text-link" href={localePath(lang, '/blog/')}>{s.home.blogLink} →</a>
        </div>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <p class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time></p>
              <h3><a href={localePath(lang, `/blog/${postSlug(post)}/`)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section-rule">
    <div class="container two-col">
      <div class="col-head">
        <h2>{s.home.visitTitle}</h2>
        <address class="visit-address">{fullAddress}</address>
        <p>{s.hours.text}<br />{s.hours.closed}</p>
        <a class="text-link" href={clinic.mapsLink} target="_blank" rel="noopener">{s.contact.directions} →</a>
      </div>
      <iframe class="map" src={clinic.mapsEmbed} title={s.contact.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <ContactBlock lang={lang} />
</Base>
